generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(100)
  shortName  String     @db.VarChar(100)
  divisions  Division[]
  users      User[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("organizations")
}

model Division {
  id             String       @id @default(uuid())
  name           String       @db.VarChar(100)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  properties     Property[]
  hubs           Hub[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("divisions")
}

model Property {
  id             String               @id @default(uuid())
  name           String               @db.VarChar(100)
  code           String               @db.VarChar(5)
  divisionId     String
  division       Division             @relation(fields: [divisionId], references: [id])
  organizationId String
  hubs           Hub[]                @relation("HubToProperty")
  departments    PropertyDepartment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([divisionId, code])
  @@index([divisionId])
  @@index([organizationId])
  @@map("properties")
}

model Hub {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(100)
  divisionId String
  division   Division   @relation(fields: [divisionId], references: [id])
  properties Property[] @relation("HubToProperty")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([divisionId])
  @@map("hubs")
}

model Department {
  id         String               @id @default(uuid())
  name       String               @unique @db.VarChar(100)
  properties PropertyDepartment[]
  userDepts  UserDepartment[]

  @@map("departments")
}

model PropertyDepartment {
  propertyId   String
  departmentId String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([propertyId, departmentId])
  @@index([propertyId])
  @@index([departmentId])
  @@map("property_departments")
}

model User {
  id             String      @id @default(uuid())
  eid            String      @unique @map("eID") @db.VarChar(10)
  email          String      @unique @db.VarChar(255)
  lastName       String      @db.VarChar(100)
  firstName      String      @db.VarChar(100)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scopes         UserScope[]
  status         UserStatus  @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId])
  @@map("users")
}

model UserScope {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  scopeLevel  ScopeLevel
  entityId    String
  departments UserDepartment[]

  @@index([userId])
  @@index([entityId, scopeLevel])
  @@map("user_scopes")
}

model UserDepartment {
  userScopeId  String
  departmentId String
  userScope    UserScope  @relation(fields: [userScopeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userScopeId, departmentId])
  @@index([userScopeId])
  @@index([departmentId])
  @@map("user_departments")
}

enum Role {
  ADMIN
  EDITOR
  OPERATOR
  VIEWER
}

enum ScopeLevel {
  ORGANIZATION
  DIVISION
  HUB
  PROPERTY
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}